{
  "schema_version": 1,
  "target_id": "scientific-html",
  "default_profile_id": "html-plotly-static-v1",
  "selection_dimensions": [
    "computation_timing",
    "interaction_semantics",
    "delivery_topology",
    "delivery_connectivity",
    "view_semantics",
    "numeric_contract"
  ],
  "verification_requirements": {
    "runner": "playwright",
    "python_packages": ["playwright"],
    "browser": true
  },
  "profiles": [
    {
      "id": "html-plotly-static-v1",
      "role": "default-product",
      "runtime_topology": "build-time-python-browser-static",
      "computation_timing": ["build-time"],
      "required_python_packages": ["numpy", "scipy", "plotly"],
      "optional_python_packages": ["sympy", "jinja2"],
      "capability_dependencies": {
        "computation": {
          "optional-symbolic": ["sympy"]
        }
      },
      "delivery_modes": [
        {"topology": "single-file", "connectivity": "offline"}
      ],
      "computation": ["arrays", "integration", "ode", "optimization", "interpolation", "fft", "linear-algebra", "optional-symbolic"],
      "views": ["line", "scatter", "heatmap", "contour", "surface-3d", "phase-portrait", "animation", "linked-views"],
      "interaction": ["hover", "pan", "zoom", "legend", "precomputed-slider", "dropdown", "named-anchor-buttons", "animation-controls"],
      "choose_when": "The browser can select finite precomputed states and does not need to rerun Python."
    },
    {
      "id": "html-bokeh-customjs-v1",
      "role": "lightweight-client-formulas",
      "runtime_topology": "build-time-python-browser-javascript",
      "computation_timing": ["build-time", "browser-javascript"],
      "required_python_packages": ["numpy", "scipy", "bokeh"],
      "optional_python_packages": ["sympy"],
      "delivery_modes": [
        {"topology": "single-file", "connectivity": "offline"}
      ],
      "capability_dependencies": {
        "computation": {
          "optional-symbolic": ["sympy"]
        }
      },
      "computation": ["build-time-scientific-python", "small-browser-formulas", "optional-symbolic"],
      "views": ["line", "scatter", "heatmap", "linked-views"],
      "interaction": ["widgets", "linked-selections", "customjs-continuous-update"],
      "choose_when": "Continuous browser updates reduce to a modest accepted JavaScript formula."
    },
    {
      "id": "html-panel-pyodide-v1",
      "role": "live-browser-python",
      "runtime_topology": "browser-python-wasm",
      "computation_timing": ["browser-time"],
      "required_python_packages": ["numpy", "scipy", "panel"],
      "optional_python_packages": ["sympy"],
      "capability_dependencies": {
        "computation": {
          "optional-symbolic": ["sympy"]
        }
      },
      "delivery_modes": [
        {"topology": "single-file-with-network-runtime", "connectivity": "connected"},
        {"topology": "static-bundle", "connectivity": "connected"},
        {"topology": "vendored-offline-bundle", "connectivity": "offline"}
      ],
      "computation": ["live-python", "live-scipy", "pyodide-compatible-packages", "optional-symbolic"],
      "views": ["panel-views", "bokeh-views", "linked-views"],
      "interaction": ["python-reactive-controls", "worker-execution"],
      "choose_when": "A control change must rerun the accepted Python or SciPy computation in the browser."
    },
    {
      "id": "html-observable-custom-v1",
      "role": "bespoke-explanatory-interface",
      "runtime_topology": "build-time-python-browser-javascript-static-site",
      "computation_timing": ["build-time", "browser-javascript"],
      "required_python_packages": ["numpy", "scipy"],
      "required_external_tools": ["node", "npm"],
      "delivery_modes": [
        {"topology": "static-site-bundle", "connectivity": "offline"}
      ],
      "computation": ["python-data-loader", "browser-javascript"],
      "views": ["observable-plot", "svg", "canvas", "custom-d3", "linked-views"],
      "interaction": ["reactive-javascript", "bespoke-linked-state"],
      "choose_when": "The explanatory interaction needs custom SVG or Canvas behavior beyond standard scientific widgets."
    },
    {
      "id": "jupyterlite-exploration-v1",
      "role": "exploration-only",
      "runtime_topology": "browser-notebook-python-wasm",
      "computation_timing": ["browser-time"],
      "required_python_packages": [],
      "required_external_tools": ["jupyter-lite"],
      "delivery_modes": [
        {"topology": "large-static-site-bundle", "connectivity": "offline"}
      ],
      "computation": ["editable-browser-python"],
      "views": ["notebook-output"],
      "interaction": ["notebook-editing"],
      "choose_when": "The requested product is an editable exploration environment rather than a focused representation."
    }
  ]
}
